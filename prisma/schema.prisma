generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  username            String
  email               String               @unique
  password            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  verifiedAt          DateTime?
  passwordResetTokens PasswordResetToken[]
  projects            Project[]
  verificationTokens  VerificationToken[]
}

model Project {
  id         String    @id @default(cuid())
  name       String
  url        String
  interval   Int  //interval is considered as minutes
  active     Boolean   @default(true)
  lastPingAt DateTime?
  userId     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  pingLogs   PingLog[]
  user       User      @relation(fields: [userId], references: [id],onDelete:Cascade)
  @@unique([userId,url])
}

model PingLog {
  id           String   @id @default(cuid())
  statusCode   Int
  responseTime Int
  success      Boolean
  projectId    String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
